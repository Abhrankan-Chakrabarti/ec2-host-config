#!/usr/bin/env bash
set -e

echo "=== [1/2] Updating Main Portal (forensic.dpdns.org) ==="
sudo git -C /var/www/forensic fetch origin build
sudo git -C /var/www/forensic reset --hard origin/build
sudo chown -R nginx:nginx /var/www/forensic

echo ""
echo "=== [2/2] Updating Pixel Workbench (pixel.forensic.dpdns.org) ==="
OLD_HEAD=$(sudo git -C /opt/pixel-forensics-workbench rev-parse HEAD)
sudo git -C /opt/pixel-forensics-workbench pull
NEW_HEAD=$(sudo git -C /opt/pixel-forensics-workbench rev-parse HEAD)

if [ "$OLD_HEAD" != "$NEW_HEAD" ]; then
    echo "⚡ New updates detected. Restarting pixel-forensics..."
    sudo systemctl restart pixel-forensics
    echo "✓ Service successfully restarted."
else
    echo "✓ Already up to date. No restart needed."
fi
